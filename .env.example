# ---------------------------------------------------------------------------
# CleanSlate configuration. Copy to .env and fill in what you need.
# Everything has a working default for local development.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Postgres (Supabase in the cloud, docker locally) ----------------------
DATABASE_URL=postgresql+psycopg://cleanslate:cleanslate@127.0.0.1:5433/cleanslate
# The RLS-enforced path. Leave blank locally; the app substitutes RL_DB_USER.
RLS_DATABASE_URL=
RLS_DB_USER=cleanslate_authenticated
RLS_DB_PASSWORD=cleanslate_authenticated

# --- MongoDB (raw landing zone) --------------------------------------------
MONGO_URL=mongodb://127.0.0.1:27018
MONGO_DB=cleanslate

# --- Supabase (optional; leave blank to run self-contained) ----------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
AUTH_MODE=auto

# --- Crypto ----------------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=change-me-in-shared-environments

# --- LLM (optional; deterministic fallback is used when unset) -------------
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=20
LLM_ENABLED=true

# --- Pipeline tuning -------------------------------------------------------
MAX_UPLOAD_MB=100
ARCHIVE_AFTER_YEARS=3
FUZZY_DUPLICATE_THRESHOLD=88

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
